//@version=6
// StratLab S-020 v1 | spec hash 6b1d442247
// Donchian Channel Breakout | BINANCE:BTCUSDT 4h
// Generated by StratLab from the StrategySpec. Do not hand-edit: change the spec instead.
// Research tool, not financial advice.
strategy("S-020 v1: Donchian Channel Breakout", shorttitle="S-020@v1", overlay=true,
     initial_capital=10000.0, default_qty_type=strategy.percent_of_equity, default_qty_value=100.0,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=1,
     pyramiding=0, process_orders_on_close=false, calc_on_every_tick=false)

// === Test window (entries only inside it) ===
startTs = timestamp("UTC", 2021, 1, 1, 0, 0)
endTs = timestamp("UTC", 2025, 12, 31, 23, 59)
inDateRange = time >= startTs and time <= endTs

// === Inputs ===
donchian_len = input.int(20, title="donchian_len", minval=10, maxval=40, step=5)
atr_stop = input.float(2.0, title="atr_stop", minval=1.0, maxval=3.0, step=0.5)

// === Indicators ===
upper_band = ta.highest(high, donchian_len)
atr = ta.atr(14)

// === Signals (evaluated on bar close) ===
longCond1 = ta.crossover(close, upper_band[1])
longSignal = inDateRange and longCond1

// === Entry: only when flat at the signal close; fills at the next bar's open ===
if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// === Exits ===
var float stopPx = na
var float tpPx = na
var int entryBar = na
if strategy.position_size > 0 and strategy.position_size[1] == 0
    // entry filled on this bar: levels from the fill price and the signal bar's ATR
    entryBar := bar_index
    stopPx := strategy.position_avg_price - atr_stop * atr[1]
    tpPx := na

if strategy.position_size > 0
    strategy.exit("Exit", from_entry="Long", stop=stopPx, limit=tpPx)
    if bar_index - entryBar >= 40 - 1
        strategy.close("Long", comment="Time exit")
    if time > endTs
        strategy.close("Long", comment="End of test window")

if strategy.position_size == 0
    stopPx := na
    tpPx := na
